# Dual-Mode Execution (true = local SQLite/in-memory mock; false = live Snowflake + Cortex AI)
SNOWFLAKE_MOCK_MODE=true

# Snowflake Connection Settings (required when SNOWFLAKE_MOCK_MODE=false)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=RBT_SERVICE_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_ROLE=RBT_PLATFORM_ROLE
SNOWFLAKE_DATABASE=RBT_GLOBAL_PLATFORM
SNOWFLAKE_SCHEMA=CORE
SNOWFLAKE_WAREHOUSE=RBT_DEFAULT_WH

# Cortex AI & Execution Guardrails
CORTEX_MODEL=claude-3-5-sonnet
MAX_AUTO_DEBUG_RETRIES=3
STATEMENT_TIMEOUT_IN_SECONDS=300
MAX_CONCURRENT_QUERIES=5
SYNC_HTTP_TIMEOUT_SECONDS=90

# OIDC / SSO JWT (required when SNOWFLAKE_MOCK_MODE=false)
OIDC_JWT_SECRET=replace-with-oidc-public-key-or-secret
OIDC_JWT_ALGORITHM=HS256
OIDC_AUDIENCE=rbt-platform

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
